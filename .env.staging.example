# =============================================================================
# Staging Environment — copy to .env.staging
# Same structure as production; use separate DB and domains.
# Deploy: docker compose -f docker-compose.prod.yml -f docker-compose.staging.yml up -d
# =============================================================================

DOMAIN_NAME=staging.example.com
API_DOMAIN=api.staging.example.com
ADMIN_DOMAIN=admin.staging.example.com
LETSENCRYPT_EMAIL=ops@example.com

POSTGRES_USER=platform
POSTGRES_PASSWORD=staging-password-change-me
POSTGRES_DB=platform_staging
BACKUP_RETENTION_DAYS=14

NODE_ENV=production
PORT=3001
API_PREFIX=v1
CORS_ORIGINS=https://staging.example.com,https://admin.staging.example.com
ENABLE_DEV_AUTH=false
ENABLE_CRON_JOBS=false

DATABASE_URL=postgresql://platform:staging-password-change-me@postgres:5432/platform_staging?schema=public
JWT_SECRET=staging-jwt-secret-min-64-characters-for-testing-only-change-me
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=30

REDIS_URL=redis://redis:6379
LETSENCRYPT_EMAIL=ops@example.com

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PLATFORM_FEE_PERCENT=30
COINS_PER_MINUTE_UNITS=500
SIGNUP_BONUS_COINS=100
FREE_CALL_LIMIT=5
FREE_CALL_MAX_SECONDS=180
REFERRAL_REWARD_UNITS=5000
WITHDRAWAL_MIN_UNITS=50000
WITHDRAWAL_HOLD_DAYS=7

EMAIL_PROVIDER=console
SMS_PROVIDER=console
EMAIL_FROM=noreply@staging.example.com
COMMUNICATIONS_INTERNAL_API_KEY=staging-internal-key-min-32-chars

STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/uploads

AI_CONVERSATION_PROVIDER=local
AI_VOICE_PROVIDER=local

SENTRY_DSN=
SENTRY_ENVIRONMENT=staging
SENTRY_TRACES_SAMPLE_RATE=0.2

NEXT_PUBLIC_API_URL=https://api.staging.example.com/v1
NEXT_PUBLIC_ENABLE_DEV_AUTH=false
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_ZEGO_APP_ID=
NEXT_PUBLIC_ZEGO_SERVER_URL=
NEXT_PUBLIC_SENTRY_DSN=