# =============================================================================
# Production Environment — copy to .env.production and fill ALL values
# Validate: npx tsx scripts/production/verify-env.ts --file .env.production
# =============================================================================

# --- Domains & SSL ---
DOMAIN_NAME=app.example.com
API_DOMAIN=api.example.com
ADMIN_DOMAIN=admin.example.com
LETSENCRYPT_EMAIL=ops@example.com

# --- PostgreSQL ---
POSTGRES_USER=platform
POSTGRES_PASSWORD=change-me-strong-password-min-24-chars
POSTGRES_DB=platform
BACKUP_RETENTION_DAYS=30

# Initial 5k-session sizing; adjust after measuring the production workload.
API_REPLICAS=6
WEB_REPLICAS=2
PRISMA_CONNECTION_LIMIT=10

# --- API Core ---
NODE_ENV=production
PORT=3001
API_PREFIX=v1
CORS_ORIGINS=https://app.example.com,https://admin.example.com
ENABLE_DEV_AUTH=false
ENABLE_CRON_JOBS=false

DATABASE_URL=postgresql://platform:change-me-strong-password-min-24-chars@postgres:5432/platform?schema=public
JWT_SECRET=change-me-to-a-long-random-secret-min-64-chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_DAYS=30

# Redis
REDIS_URL=redis://redis:6379


# Zego RTC (server secret must be exactly 32 chars)
ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Platform economics
PLATFORM_FEE_PERCENT=30
COINS_PER_MINUTE_UNITS=500
SIGNUP_BONUS_COINS=100
FREE_CALL_LIMIT=5
FREE_CALL_MAX_SECONDS=180
REFERRAL_REWARD_UNITS=5000
WITHDRAWAL_MIN_UNITS=50000
WITHDRAWAL_HOLD_DAYS=7

# Communications
EMAIL_PROVIDER=sendgrid
SMS_PROVIDER=msg91
EMAIL_FROM=noreply@example.com
COMMUNICATIONS_INTERNAL_API_KEY=change-me-internal-key-min-32-chars
SENDGRID_API_KEY=
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=4

# Storage (local | s3 | r2)
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=/app/uploads
# STORAGE_BUCKET=
# STORAGE_ENDPOINT=
# STORAGE_REGION=auto
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# AI providers (optional — defaults to local)
AI_CONVERSATION_PROVIDER=local
AI_VOICE_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=

# Monitoring
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# --- Web build args (used by Docker build) ---
NEXT_PUBLIC_API_URL=https://api.example.com/v1
NEXT_PUBLIC_ENABLE_DEV_AUTH=false
NEXT_PUBLIC_ZEGO_APP_ID=
NEXT_PUBLIC_ZEGO_SERVER_URL=
NEXT_PUBLIC_SENTRY_DSN=

# Native authentication (Google and SMS keys stay on the backend)
WEB_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/v1/auth/google/callback
MSG91_OTP_TEMPLATE_ID=
MSG91_OTP_VARIABLE=OTP
