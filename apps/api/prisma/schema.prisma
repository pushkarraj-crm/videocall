// =============================================================================
// IDENTITY & COMPLIANCE
// =============================================================================

model User {
  id                String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  authIdentity       String     @unique @map("firebase_uid") @db.VarChar(128)
  phone             String?    @db.VarChar(16)
  email             String?    @db.VarChar(255)
  displayName       String     @map("display_name") @db.VarChar(50)
  avatarUrl         String?    @map("avatar_url")
  bio               String?    @db.VarChar(500)
  dateOfBirth       DateTime   @map("date_of_birth") @db.Date
  gender            Gender?
  primaryLanguage   String     @default("en") @map("primary_language") @db.VarChar(10)
  referralCode      String     @unique @map("referral_code") @db.VarChar(20)
  referredById      String?    @map("referred_by_id") @db.Uuid
  abuseScore        Int        @default(0) @map("abuse_score")
  status            UserStatus @default(active)
  freeCallsUsed     Int        @default(0) @map("free_calls_used") @db.SmallInt
  deviceFingerprint String?    @map("device_fingerprint") @db.VarChar(64)
  adminNote                String?  @map("admin_note")
  communityWarningVisible  Boolean  @default(false) @map("community_warning_visible")
  sessionRevokedAt         DateTime? @map("session_revoked_at") @db.Timestamptz(6)
  lastLoginAt              DateTime? @map("last_login_at") @db.Timestamptz(6)
  lastSeenAt        DateTime?  @map("last_seen_at") @db.Timestamptz(6)
  createdAt         DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?  @map("deleted_at") @db.Timestamptz(6)

  referredBy User?  @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals  User[] @relation("UserReferrals")

  roles                    UserRole[]
  rolesGranted             UserRole[]            @relation("RoleGranter")
  consents                 UserConsent[]
  wallet                   Wallet?
  walletTransactions       WalletTransaction[]
  refreshTokens            RefreshToken[]
  credential               AuthCredential?
  recoveryTokens           AuthRecoveryToken[]
  googleIdentity           AuthGoogleIdentity?
  phoneIdentity            AuthPhoneIdentity?
  referralsMade            Referral[]            @relation("Referrer")
  referralReceived         Referral?             @relation("Referred")
  hostApplication          HostApplication?
  hostKycRecords           HostKyc[]
  hostProfile              HostProfile?
  hostBankAccounts         HostBankAccount[]
  hostEarnings             HostEarning[]
  withdrawals              Withdrawal[]
  withdrawalsApproved      Withdrawal[]          @relation("WithdrawalApprover")
  callsAsCaller            Call[]                @relation("Caller")
  callsAsCallee              Call[]                @relation("Callee")
  callHistoryAsCaller      CallHistory[]         @relation("CallHistoryCaller")
  callHistoryAsHost        CallHistory[]         @relation("CallHistoryHost")
  callConsents             CallConsent[]
  giftsSent                CallGift[]            @relation("GiftSender")
  giftsReceived            CallGift[]            @relation("GiftRecipient")
  swipesMade               Swipe[]               @relation("Swiper")
  swipesReceived           Swipe[]               @relation("SwipeTarget")
  matchesAsA               Match[]               @relation("MatchUserA")
  matchesAsB               Match[]               @relation("MatchUserB")
  conversationsAsA         Conversation[]        @relation("ConversationA")
  conversationsAsB         Conversation[]        @relation("ConversationB")
  messagesSent             Message[]
  blocksMade               Block[]               @relation("Blocker")
  blocksReceived           Block[]               @relation("Blocked")
  reportsMade              Report[]              @relation("Reporter")
  reportsReceived          Report[]              @relation("Reported")
  reportsAssigned          Report[]              @relation("ReportAssignee")
  reportsResolved          Report[]              @relation("ReportResolver")
  abuseSignals             AbuseSignal[]
  suspensions              AccountSuspension[]
  suspensionsIssued        AccountSuspension[]   @relation("SuspensionIssuer")
  suspensionsLifted        AccountSuspension[]   @relation("SuspensionLifter")
  moderationItems          ModerationQueue[]     @relation("ModerationSubject")
  moderationReviews        ModerationQueue[]     @relation("ModerationReviewer")
  auditLogs                AuditLog[]
  adminLogsPerformed       AdminLog[]            @relation("AdminLogActor")
  adminLogsTargeted        AdminLog[]            @relation("AdminLogTarget")
  configUpdates            PlatformConfig[]
  grievanceTickets         GrievanceTicket[]
  payments                 Payment[]
  deviceTokens             DeviceToken[]
  notifications            Notification[]
  hostApplicationsReviewed HostApplication[]     @relation("HostApplicationReviewer")
  reviewsGiven             Review[]              @relation("ReviewAuthor")
  reviewsReceived          Review[]              @relation("ReviewHost")
  hostsFollowed            HostFollower[]        @relation("FollowerUser")
  hostFollowers            HostFollower[]        @relation("FollowedHost")
  promoUsages              PromoUsage[]
  promoApplication         PromoApplication?
  notificationSettings     NotificationSettings?
  notificationBroadcasts   NotificationBroadcast[] @relation("BroadcastAdmin")
  communicationSettings    CommunicationSettings?
  communicationLogs        CommunicationLog[]
  communicationCampaigns   CommunicationCampaign[] @relation("CommunicationCampaignAdmin")
  riskEvents               RiskEvent[]
  fraudFlags               FraudFlag[]
  riskProfile              RiskUserProfile?
  deviceFingerprints       DeviceFingerprintRecord[]
  riskAudits               RiskDecisionAudit[]     @relation("RiskAuditUser")
  virtualHostSessions      VirtualHostSession[]    @relation("VirtualHostSessionUser")
  virtualHostMemories      VirtualHostMemory[]     @relation("VirtualHostMemoryUser")
  virtualHostConversationTurns VirtualHostConversationTurn[] @relation("VirtualHostConversationUser")
  virtualHostVoiceSessions     VirtualHostVoiceSession[]     @relation("VirtualHostVoiceUser")
  aiHostMemories           AIHostMemory[]          @relation("AIHostMemoryUser")
  aiHostMemoriesAsHost     AIHostMemory[]          @relation("AIHostMemoryHost")
  conversationHistory      ConversationHistory[]   @relation("ConversationHistoryUser")
  conversationHistoryAsHost ConversationHistory[]  @relation("ConversationHistoryHost")
  legalPoliciesPublished   LegalPolicy[]           @relation("LegalPolicyPublisher")
  legalPolicyRevisions     LegalPolicyRevision[]   @relation("LegalPolicyRevisionPublisher")

  @@index([status, deletedAt])
  @@index([status, lastSeenAt])
  @@index([abuseScore(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("users")
}

model UserRole {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  role        Role
  grantedById String?   @map("granted_by_id") @db.Uuid
  grantedAt   DateTime  @default(now()) @map("granted_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  grantedBy User? @relation("RoleGranter", fields: [grantedById], references: [id], onDelete: SetNull)

  @@unique([userId, role])
  @@index([userId])
  @@index([role])
  @@map("user_roles")
}

model LegalDocument {
  id           String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentType ConsentDocumentType @map("document_type")
  version      String              @db.VarChar(20)
  title        String              @db.VarChar(200)
  contentUrl   String              @map("content_url")
  isActive     Boolean             @default(false) @map("is_active")
  publishedAt  DateTime?           @map("published_at") @db.Timestamptz(6)
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  consents UserConsent[]

  @@unique([documentType, version])
  @@index([documentType, isActive])
  @@map("legal_documents")
}

model UserConsent {
  id              String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String              @map("user_id") @db.Uuid
  documentType    ConsentDocumentType @map("document_type")
  documentVersion String              @map("document_version") @db.VarChar(20)
  legalDocumentId String?             @map("legal_document_id") @db.Uuid
  ipAddress       String?             @map("ip_address") @db.Inet
  userAgent       String?             @map("user_agent")
  consentedAt     DateTime            @default(now()) @map("consented_at") @db.Timestamptz(6)
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  legalDocument LegalDocument? @relation(fields: [legalDocumentId], references: [id], onDelete: SetNull)

  @@index([userId, documentType])
  @@index([consentedAt(sort: Desc)])
  @@map("user_consents")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// Password credentials are separate from profile data so API profile serializers
// can never accidentally return password hashes. Email is normalized before storage.
model AuthCredential {
  userId          String    @id @map("user_id") @db.Uuid
  email           String    @unique @db.VarChar(255)
  passwordHash    String    @map("password_hash") @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(6)
  failedAttempts  Int       @default(0) @map("failed_attempts")
  lockedUntil     DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("auth_credentials")
}

model AuthRecoveryToken {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  email      String    @db.VarChar(255)
  purpose    String    @db.VarChar(20)
  intent     String?   @db.VarChar(10)
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt     DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
  @@map("auth_recovery_tokens")
}

model AuthGoogleIdentity {
  subject String @id @db.VarChar(255)
  userId  String @unique @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("auth_google_identities")
}

model AuthPhoneIdentity {
  phone  String @id @db.VarChar(16)
  userId String @unique @map("user_id") @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("auth_phone_identities")
}

model AuthOtpChallenge {
  id        String    @id @db.Uuid
  phone     String    @db.VarChar(16)
  codeHash  String    @map("code_hash") @db.VarChar(64)
  intent    String    @db.VarChar(10)
  attempts  Int       @default(0)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  @@index([phone, createdAt])
  @@index([expiresAt])
  @@map("auth_otp_challenges")
}

// =============================================================================
// COIN WALLET
// =============================================================================

model Wallet {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  balanceUnits          BigInt   @default(0) @map("balance_units")
  lockedUnits           BigInt   @default(0) @map("locked_units")
  lifetimeCreditedUnits BigInt   @default(0) @map("lifetime_credited_units")
  lifetimeDebitedUnits  BigInt   @default(0) @map("lifetime_debited_units")
  version               Int      @default(0)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]

  @@map("wallets")
}

model WalletTransaction {
  id                String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId          String                @map("wallet_id") @db.Uuid
  userId            String                @map("user_id") @db.Uuid
  type              WalletTransactionType
  amountUnits       BigInt                @map("amount_units")
  balanceAfterUnits BigInt                @map("balance_after_units")
  referenceType     String?               @map("reference_type") @db.VarChar(50)
  referenceId       String?               @map("reference_id") @db.Uuid
  idempotencyKey    String                @unique @map("idempotency_key") @db.VarChar(128)
  description       String?               @db.VarChar(255)
  metadata          Json?
  createdAt         DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Restrict)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt(sort: Desc)])
  @@index([userId, type, createdAt(sort: Desc)])
  @@index([referenceType, referenceId])
  @@map("wallet_transactions")
}

model CoinPackage {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String    @db.VarChar(100)
  priceInr    Decimal   @map("price_inr") @db.Decimal(12, 2)
  mrpInr      Decimal?  @map("mrp_inr") @db.Decimal(12, 2)
  coinUnits   BigInt    @map("coin_units")
  bonusUnits  BigInt    @default(0) @map("bonus_units")
  isBestValue    Boolean   @default(false) @map("is_best_value")
  isMostPopular  Boolean   @default(false) @map("is_most_popular")
  isLimitedOffer Boolean   @default(false) @map("is_limited_offer")
  isActive       Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order") @db.SmallInt
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz(6)

  payments Payment[]

  @@index([isActive, sortOrder])
  @@map("coin_packages")
}

// =============================================================================
// REFERRAL
// =============================================================================

model Referral {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  referrerId          String         @map("referrer_id") @db.Uuid
  referredId          String         @unique @map("referred_id") @db.Uuid
