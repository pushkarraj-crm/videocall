// =============================================================================
// MESSAGING
// =============================================================================

model Conversation {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  participantAId     String    @map("participant_a_id") @db.Uuid
  participantBId     String    @map("participant_b_id") @db.Uuid
  lastMessageAt      DateTime? @map("last_message_at") @db.Timestamptz(6)
  lastMessagePreview String?   @map("last_message_preview") @db.VarChar(100)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)

  participantA User      @relation("ConversationA", fields: [participantAId], references: [id], onDelete: Restrict)
  participantB User      @relation("ConversationB", fields: [participantBId], references: [id], onDelete: Restrict)
  messages     Message[]

  @@unique([participantAId, participantBId])
  @@index([participantAId, lastMessageAt(sort: Desc)])
  @@index([participantBId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId   String                  @map("conversation_id") @db.Uuid
  senderId         String                  @map("sender_id") @db.Uuid
  content          String
  moderationStatus MessageModerationStatus @default(approved) @map("moderation_status")
  flaggedReason    String?                 @map("flagged_reason") @db.VarChar(100)
  readAt           DateTime?               @map("read_at") @db.Timestamptz(6)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(6)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Restrict)
  reports      Report[]

  @@index([conversationId, createdAt(sort: Desc)])
  @@index([moderationStatus, createdAt])
  @@map("messages")
}

