model CommunicationQueueItem {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String?                  @map("user_id") @db.Uuid
  campaignId      String?                  @map("campaign_id") @db.Uuid
  channel         CommunicationChannel
  eventType       CommunicationEventType   @map("event_type")
  recipient       String                   @db.VarChar(255)
  subject         String?                  @db.VarChar(300)
  body            String
  htmlBody        String?                  @map("html_body")
  templateKey     String                   @map("template_key") @db.VarChar(50)
  templateData    Json?                    @map("template_data")
  status          CommunicationQueueStatus @default(pending)
  idempotencyKey  String                   @unique @map("idempotency_key") @db.VarChar(128)
  attempts        Int                      @default(0) @db.SmallInt
  maxAttempts     Int                      @default(5) @map("max_attempts") @db.SmallInt
  nextRetryAt     DateTime?                @map("next_retry_at") @db.Timestamptz(6)
  lastError       String?                  @map("last_error")
  referenceId     String?                  @map("reference_id") @db.Uuid
  referenceType   String?                  @map("reference_type") @db.VarChar(30)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  processedAt     DateTime?                @map("processed_at") @db.Timestamptz(6)

  campaign CommunicationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  log      CommunicationLog?

  @@index([status, nextRetryAt, createdAt])
  @@index([userId, eventType, createdAt(sort: Desc)])
  @@index([campaignId])
  @@map("communication_queue")
}

model CommunicationLog {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String?                @map("user_id") @db.Uuid
  campaignId       String?                @map("campaign_id") @db.Uuid
  queueItemId      String?                @unique @map("queue_item_id") @db.Uuid
  templateId       String?                @map("template_id") @db.Uuid
  channel          CommunicationChannel
  eventType        CommunicationEventType @map("event_type")
  template         String?                @db.VarChar(50)
  recipient        String                 @db.VarChar(255)
  subject          String?                @db.VarChar(300)
  status           CommunicationLogStatus @default(queued)
  provider         String?                @db.VarChar(30)
  providerId       String?                @map("provider_id") @db.VarChar(128)
  providerResponse Json?                  @map("provider_response")
  retryCount       Int                    @default(0) @map("retry_count") @db.SmallInt
  openedAt         DateTime?              @map("opened_at") @db.Timestamptz(6)
  clickedAt        DateTime?              @map("clicked_at") @db.Timestamptz(6)
  deliveredAt      DateTime?              @map("delivered_at") @db.Timestamptz(6)
  failedAt         DateTime?              @map("failed_at") @db.Timestamptz(6)
  bounceReason     String?                @map("bounce_reason")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)

  user      User?                    @relation(fields: [userId], references: [id], onDelete: SetNull)
  campaign  CommunicationCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  queueItem CommunicationQueueItem?  @relation(fields: [queueItemId], references: [id], onDelete: SetNull)
  templateRef CommunicationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([channel, status, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([campaignId, status])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("communication_logs")
}

