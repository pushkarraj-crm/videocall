model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  packageId         String?       @map("package_id") @db.Uuid
  razorpayOrderId   String        @unique @map("razorpay_order_id") @db.VarChar(64)
  razorpayPaymentId String?       @map("razorpay_payment_id") @db.VarChar(64)
  razorpaySignature String?       @map("razorpay_signature") @db.VarChar(128)
  amountInr         Decimal       @map("amount_inr") @db.Decimal(12, 2)
  gstInr            Decimal       @default(0) @map("gst_inr") @db.Decimal(12, 2)
  totalInr          Decimal       @map("total_inr") @db.Decimal(12, 2)
  coinUnitsCredited BigInt        @default(0) @map("coin_units_credited")
  status            PaymentStatus @default(created)
  paymentMethod     String?       @map("payment_method") @db.VarChar(30)
  invoiceNumber     String?       @map("invoice_number") @db.VarChar(30)
  invoiceUrl        String?       @map("invoice_url")
  failureReason     String?       @map("failure_reason")
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(128)
  metadata          Json?
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  user          User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  package       CoinPackage?          @relation(fields: [packageId], references: [id], onDelete: SetNull)
  webhookEvents PaymentWebhookEvent[]

  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt])
  @@index([razorpayPaymentId])
  @@map("payments")
}

model PaymentWebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  razorpayEventId String    @unique @map("razorpay_event_id") @db.VarChar(64)
  eventType       String    @map("event_type") @db.VarChar(50)
  paymentId       String?   @map("payment_id") @db.Uuid
  payload         Json
  processed       Boolean   @default(false)
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  error           String?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)

  @@index([processed, createdAt])
  @@index([eventType, createdAt(sort: Desc)])
  @@map("payment_webhook_events")
}

