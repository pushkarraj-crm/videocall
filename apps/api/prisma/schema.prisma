model Block {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  reason    String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
  @@map("blocks")
}

model Report {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId       String            @map("reporter_id") @db.Uuid
  reportedId       String            @map("reported_id") @db.Uuid
  callId           String?           @map("call_id") @db.Uuid
  messageId        String?           @map("message_id") @db.Uuid
  category         ReportCategory
  description      String?
  evidenceUrl      String?           @map("evidence_url")
  status           ReportStatus      @default(open)
  severity         ReportSeverity    @default(medium)
  assignedToId     String?           @map("assigned_to_id") @db.Uuid
  resolution       String?
  resolutionAction ResolutionAction? @map("resolution_action")
  resolvedById     String?           @map("resolved_by_id") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  resolvedAt       DateTime?         @map("resolved_at") @db.Timestamptz(6)

  reporter    User                @relation("Reporter", fields: [reporterId], references: [id], onDelete: Restrict)
  reported    User                @relation("Reported", fields: [reportedId], references: [id], onDelete: Restrict)
  call        Call?               @relation(fields: [callId], references: [id], onDelete: SetNull)
  message     Message?            @relation(fields: [messageId], references: [id], onDelete: SetNull)
  assignedTo  User?               @relation("ReportAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  resolvedBy  User?               @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  suspensions AccountSuspension[]

  @@index([status, severity, createdAt])
  @@index([reportedId, createdAt(sort: Desc)])
  @@index([assignedToId, status])
  @@map("reports")
}

model AbuseSignal {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  signalType  String   @map("signal_type") @db.VarChar(50)
  scoreDelta  Int      @map("score_delta")
  sourceTable String?  @map("source_table") @db.VarChar(50)
  sourceId    String?  @map("source_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([signalType, createdAt(sort: Desc)])
  @@map("abuse_signals")
}

model AccountSuspension {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String       @map("user_id") @db.Uuid
  reason        String
  suspendedById String       @map("suspended_by_id") @db.Uuid
  reportId      String?      @map("report_id") @db.Uuid
  startsAt      DateTime     @default(now()) @map("starts_at") @db.Timestamptz(6)
  endsAt        DateTime?    @map("ends_at") @db.Timestamptz(6)
  isPermanent   Boolean      @default(false) @map("is_permanent")
  appealStatus  AppealStatus @default(none) @map("appeal_status")
  appealNotes   String?      @map("appeal_notes")
  liftedAt      DateTime?    @map("lifted_at") @db.Timestamptz(6)
  liftedById    String?      @map("lifted_by_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  user        User    @relation(fields: [userId], references: [id], onDelete: Restrict)
  suspendedBy User    @relation("SuspensionIssuer", fields: [suspendedById], references: [id], onDelete: Restrict)
  report      Report? @relation(fields: [reportId], references: [id], onDelete: SetNull)
  liftedBy    User?   @relation("SuspensionLifter", fields: [liftedById], references: [id], onDelete: SetNull)

  @@index([userId, endsAt])
  @@index([appealStatus])
  @@map("account_suspensions")
}

model ModerationQueue {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  targetType     ModerationTargetType  @map("target_type")
  targetId       String                @map("target_id") @db.Uuid
  userId         String?               @map("user_id") @db.Uuid
  status         ModerationQueueStatus @default(pending)
  priority       Int                   @default(5) @db.SmallInt
  autoFlagReason String?               @map("auto_flag_reason") @db.VarChar(100)
  moderatorNotes String?               @map("moderator_notes")
  reviewedById   String?               @map("reviewed_by_id") @db.Uuid
  reviewedAt     DateTime?             @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user       User? @relation("ModerationSubject", fields: [userId], references: [id], onDelete: SetNull)
  reviewedBy User? @relation("ModerationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@index([targetType, targetId])
  @@index([userId])
  @@map("moderation_queue")
}

