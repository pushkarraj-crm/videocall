# Development only — production uses root .env.production (see .env.production.example)
NODE_ENV=development
PORT=3001
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3000

APP_TITLE=
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/platform?schema=public"

JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Dev auth bypass (never enable in production)
ENABLE_DEV_AUTH=true

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Must match the same ZEGOCLOUD project as NEXT_PUBLIC_ZEGO_APP_ID on the web app
ZEGO_APP_ID=
# Must be exactly 32 characters from the same ZEGOCLOUD project console (ServerSecret)
ZEGO_SERVER_SECRET=
# Optional: set "true" only if room-privilege token auth is enabled in Zego console
# ZEGO_TOKEN_ROOM_PRIVILEGE=false

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

PLATFORM_FEE_PERCENT=30
COINS_PER_MINUTE_UNITS=500
SIGNUP_BONUS_COINS=100
JWT_REFRESH_EXPIRES_DAYS=30
FREE_CALL_LIMIT=5
FREE_CALL_MAX_SECONDS=180
REFERRAL_REWARD_UNITS=5000
WITHDRAWAL_MIN_UNITS=50000
WITHDRAWAL_HOLD_DAYS=7

# Email & SMS (provider selected via env — no code changes needed to switch)
EMAIL_PROVIDER=console
SMS_PROVIDER=console
EMAIL_FROM=noreply@platform.app
COMMUNICATIONS_INTERNAL_API_KEY=dev-internal-communications-key

# SMTP (when EMAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# SendGrid (when EMAIL_PROVIDER=sendgrid)
SENDGRID_API_KEY=

# Resend (when EMAIL_PROVIDER=resend)
RESEND_API_KEY=

# Provider failover (optional)
EMAIL_PROVIDER_FALLBACK=smtp
SMS_PROVIDER_FALLBACK=msg91

# Twilio (when SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# MSG91 (when SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_ROUTE=4

# Textlocal (when SMS_PROVIDER=textlocal)
TEXTLOCAL_API_KEY=
TEXTLOCAL_SENDER=

# AI Conversation Engine (Virtual Hosts extension)
AI_CONVERSATION_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# AI Voice Streaming Engine (Virtual Hosts extension)
AI_VOICE_PROVIDER=local
ELEVENLABS_API_KEY=
CARTESIA_API_KEY=