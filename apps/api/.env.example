NODE_ENV=development
PORT=3001
API_PREFIX=v1
CORS_ORIGINS=http://localhost:3000

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/platform?schema=public"

JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Dev auth bypass (never enable in production)
ENABLE_DEV_AUTH=true

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

ZEGO_APP_ID=
ZEGO_SERVER_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

GST_RATE=18
PLATFORM_FEE_PERCENT=30
COINS_PER_MINUTE_UNITS=500
FREE_CALL_LIMIT=5
REFERRAL_REWARD_UNITS=5000
WITHDRAWAL_MIN_UNITS=50000
WITHDRAWAL_HOLD_DAYS=7