NEXT_PUBLIC_API_URL=http://localhost:3001/v1
NEXT_PUBLIC_APP_TITLE=Lovenexa

# Dev login buttons (development only — hidden in production)
# Also enabled automatically when NODE_ENV=development
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
NEXT_PUBLIC_ENABLE_DEV_AUTH=false


# Must match API ZEGO_APP_ID (same ZEGOCLOUD project)
NEXT_PUBLIC_ZEGO_APP_ID=
# Copy "Server URL" from ZEGOCLOUD console when available.
# If unset, defaults to accesshub endpoints (legacy webliveroom-hk.zego.im is NXDOMAIN).
# Example: wss://accesshub-wss.zego.im/ws
NEXT_PUBLIC_ZEGO_SERVER_URL=