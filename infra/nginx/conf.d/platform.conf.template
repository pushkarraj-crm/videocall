upstream platform_web {
  server web:3000;
  keepalive 32;
}

upstream platform_api {
  server api:3001;
  keepalive 32;
}

# Shared proxy settings
map $http_upgrade $connection_upgrade {
  default upgrade;
  '' close;
}

# --- HTTP → HTTPS redirect + ACME ---
server {
  listen 80;
  server_name ${DOMAIN_NAME} ${API_DOMAIN} ${ADMIN_DOMAIN};

  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

# --- App (app.domain.com) ---
server {
  listen 443 ssl http2;
  server_name ${DOMAIN_NAME};

  ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:50m;
  ssl_protocols TLSv1.2 TLSv1.3;

  include /etc/nginx/snippets/security-headers.conf;

  limit_req zone=web_limit burst=100 nodelay;
  limit_conn conn_limit 50;

  # Next.js static assets — long cache
  location /_next/static/ {
    proxy_pass http://platform_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    add_header Cache-Control "public, max-age=604800, immutable";
    expires 7d;
    access_log off;
  }

  # AI host video assets — immutable cache
  location /ai-hosts/ {
    proxy_pass http://platform_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    add_header Cache-Control "public, max-age=2592000, immutable";
    expires 30d;
    access_log off;
  }

  # Public images / gallery served by Next
  location ~* ^/(images|gallery|avatars)/ {
    proxy_pass http://platform_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    add_header Cache-Control "public, max-age=86400";
    expires 1d;
  }

  # KYC documents must never be served publicly — use authenticated admin API only
  location /uploads/kyc/ {
    deny all;
    return 404;
  }

  # Non-sensitive user uploads (gallery, etc.)
  location /uploads/ {
    alias /var/www/uploads/;
    add_header Cache-Control "private, max-age=3600";
    add_header X-Content-Type-Options "nosniff" always;
    autoindex off;
  }

  location / {
    proxy_pass http://platform_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 86400;
    proxy_buffering off;
  }
}

# --- Admin (admin.domain.com) — same Next.js app, admin routes ---
server {
  listen 443 ssl http2;
  server_name ${ADMIN_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:50m;
  ssl_protocols TLSv1.2 TLSv1.3;

  include /etc/nginx/snippets/security-headers.conf;

  limit_req zone=web_limit burst=80 nodelay;
  limit_conn conn_limit 30;

  location /_next/static/ {
    proxy_pass http://platform_web;
    add_header Cache-Control "public, max-age=604800, immutable";
    expires 7d;
    access_log off;
  }

  location / {
    proxy_pass http://platform_web;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 86400;
  }
}

# --- API (api.domain.com) ---
server {
  listen 443 ssl http2;
  server_name ${API_DOMAIN};

  ssl_certificate /etc/letsencrypt/live/${DOMAIN_NAME}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN_NAME}/privkey.pem;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:50m;
  ssl_protocols TLSv1.2 TLSv1.3;

  include /etc/nginx/snippets/security-headers.conf;

  limit_req zone=api_limit burst=60 nodelay;
  limit_conn conn_limit 100;

  # Health — no access log
  location = /v1/health {
    proxy_pass http://platform_api;
    access_log off;
  }

  location = /v1/health/live {
    proxy_pass http://platform_api;
    access_log off;
  }

  location = /v1/health/ready {
    proxy_pass http://platform_api;
    access_log off;
  }

  location = /v1/health/metrics {
    proxy_pass http://platform_api;
    access_log off;
    # Restrict metrics to internal networks in production
    allow 127.0.0.1;
    allow 10.0.0.0/8;
    allow 172.16.0.0/12;
    allow 192.168.0.0/16;
    deny all;
  }

  # SSE notifications stream
  location /v1/notifications/stream {
    proxy_pass http://platform_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Connection '';
    proxy_buffering off;
    proxy_cache off;
    chunked_transfer_encoding off;
    proxy_read_timeout 86400;
  }

  # WebSocket / long-polling upgrades
  location /v1/ {
    proxy_pass http://platform_api;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_read_timeout 300;
    client_max_body_size 25m;
  }
}