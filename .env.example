# =============================================================================
# Platform Environment Overview
# =============================================================================
#
# Three environments — never commit real secrets:
#
#   Development   apps/api/.env + apps/web/.env.local
#   Staging       .env.staging    (copy from .env.staging.example)
#   Production    .env.production (copy from .env.production.example)
#
# Validate before deploy:
#   npx tsx scripts/production/verify-env.ts --file .env.production
#
# =============================================================================

# --- Development (local) ---
# See apps/api/.env.example and apps/web/.env.example

# --- Required in ALL deployed environments ---
# DOMAIN_NAME=app.example.com
# API_DOMAIN=api.example.com
# ADMIN_DOMAIN=admin.example.com
# POSTGRES_PASSWORD=
# JWT_SECRET=           (min 64 chars in production)
# DATABASE_URL=
# CORS_ORIGINS=
# ENABLE_DEV_AUTH=false
# FIREBASE_PROJECT_ID=
# ZEGO_APP_ID=
# ZEGO_SERVER_SECRET=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# COMMUNICATIONS_INTERNAL_API_KEY=
# NEXT_PUBLIC_API_URL=https://api.example.com/v1

# --- Deploy commands ---
# Docker:  npm run docker:prod:up
# PM2:     pm2 start ecosystem.config.cjs --env production
# Verify:  npm run prod:verify